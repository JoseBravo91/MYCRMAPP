# Base de Datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/mycrmapp_dev"

# Autenticación JWT
# Generar con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio-de-48-bytes"
# Duración del access token (segundos) y del refresh token (días)
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_DAYS="7"

# Permitir auto-registro público (crea usuarios con rol VENDEDOR)
ALLOW_REGISTRATION="true"

# CORS: orígenes permitidos separados por coma (además del propio dominio)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5000"

# Gemini API
GEMINI_API_KEY="tu-api-key-de-google-gemini"
GEMINI_MODEL="gemini-2.5-flash"

# Otros
NODE_ENV="development"
